<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 40px;">
    <div class="row w-100" style="max-width: 1000px;">
        
        <div class="col-md-6 d-flex align-items-center justify-content-center">
            <img src="/img/Kooz.png" alt="Login Illustration" class="img-fluid" style="max-height: 500px;">
        </div>
        
        <!-- Left Section (Login Form with Background Color) -->
        <div class="col-md-6 d-flex align-items-center justify-content-center" style="background-color: #f8f9fa; padding: 40px;">
            <div class="card border-0 w-100">
                <div class="card-body">
                    <h1 class="card-title text-center" style="font-size: 3rem;">Welcome, please login</h1>
                    <form method="POST" action="/login">
                        <div class="form-group">
                            <label for="email" style="font-size: 1.5rem;">Email</label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="Enter email" required style="font-size: 1.5rem; padding: 15px;">
                        </div>
                        <div class="form-group mt-3">
                            <label for="password" style="font-size: 1.5rem;">Password</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" required style="font-size: 1.5rem; padding: 15px;">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block mt-3" style="font-size: 1.5rem; padding: 15px;">Login</button>
                    </form>
                    <div class="text-center mt-3">
                        <h2 style="font-size: 1.5rem;">Don't have a login? Sign up here</h2>
                        <a href="/register" class="btn btn-secondary" style="font-size: 1.5rem; padding: 15px;">Sign Up</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Section (Image) -->
        
    </div>
</div>
