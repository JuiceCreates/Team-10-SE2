<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">
        <div class="col-8 bg-login">
            <div class="slogan-container">
                <h2 class="ps-4 slogan-text">Kooz knows best, </h2>
                <h2 class="ps-5 slogan-text">quiz like the rest!</h2>
            </div>
            <div class="kuizlet-text">
                <h1 class="display-1">KOOZLET</h1>
            </div>
            <div class="d-flex justify-content-end align-items-end h-75 pe-0" style="margin-top: 16rem;">
                <img src="/img/KoozNoBackReflected.png" alt="Login Illustration" class="img-fluid kooz-image-container">
            </div>


        </div>

        <div class="col-4 p-0">
            <div class="card shadow-sm h-100 rounded-0">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-start gap-4 ps-5">
                        <button class="tab-button">Sign Up</button>
                        <button class="tab-button active">Log In</button>
                    </div>
                    <form method="POST" action="/login" style="margin-top: 10rem;">
                        <div class="form-group mb-4 ps-5">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email"
                                placeholder="Enter email" required>
                        </div>
                        <div class="form-group mb-4 ps-5">
                            <label for="password" class="form-label">Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" id="password"
                                    name="password" placeholder="Enter password" required>
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="far fa-eye-slash" id="toggleIcon"></i>
                                </button>
                            </div>
                        </div>
                        <div class="ps-5">
                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-4 py-3">Login</button>
                        </div>
                        <div class="ps-5 text-center">
                            <p class="text-muted small">
                                By clicking Log in, you accept Quizlet's
                                <a href="/terms" class="text-decoration-none">Terms of Service</a> and
                                <a href="/privacy" class="text-decoration-none">Privacy Policy</a>
                            </p>
                        </div>
                    </form>
                    <div class="text-center ps-5">
                        <a href="/register" class="btn btn-outline-secondary btn-lg w-100 mb-4 ">New to Koozlet? Create
                            an account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const password = document.getElementById('password');
    const icon = document.getElementById('toggleIcon');
    password.type = 'password';
    icon.className = 'far fa-eye-slash';

    document.getElementById('togglePassword').addEventListener('click', function () {
        if (password.type === 'password') {
            password.type = 'text';
            icon.className = 'far fa-eye';
        } else {
            password.type = 'password';
            icon.className = 'far fa-eye-slash';
        }
    });
</script>