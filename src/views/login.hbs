<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">
        <!-- Left Section (70%) -->
        <div class="col-8 d-flex flex-column justify-content-center align-items-center bg-light">
            <h2 class="mb-4">Kooz knows best, quiz like the rest</h2>
            <img src="/img/Kooz.png" alt="Login Illustration" class="img-fluid" style="max-height: 70vh;">
        </div>

        <!-- Right Section (30%) -->
        <div class="col-4 p-0">
            <div class="card shadow-sm h-100 rounded-0">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-start gap-4 mb-5">
                        <button class="btn btn-outline-primary btn-lg">Sign Up</button>
                        <button class="btn btn-primary btn-lg">Log In</button>
                        
                    </div>
                    <form method="POST" action="/login">
                        <div class="form-group mb-4">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" 
                                   class="form-control form-control-lg" 
                                   id="email" 
                                   name="email" 
                                   placeholder="Enter email" 
                                   required>
                        </div>
                        <div class="form-group mb-4">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" 
                                   class="form-control form-control-lg" 
                                   id="password" 
                                   name="password" 
                                   placeholder="Enter password" 
                                   required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">Login</button>
                    </form>
                    <div class="text-center">
                        <p class="mb-3">Don't have a login?</p>
                        <a href="/register" class="btn btn-secondary btn-lg">Sign Up</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>