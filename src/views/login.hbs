<div class="container-fluid min-vh-100">
    <div class="row min-vh-100">
        <div class="col-8 bg-dark-blue">
           <div style="padding: 5rem 0 0 8rem;">
                <h2 class="ps-4 text-white">Kooz knows best, </h2>
                <h2 class="ps-5 text-white">quiz like the rest!</h2>
            </div>
            <div class="d-flex justify-content-end align-items-center h-75">
                <img src="/img/KoozNoBackReflected.png" alt="Login Illustration" class="img-fluid"
                    style="max-height: 70vh;">
            </div>
        </div>

        <div class="col-4 p-0">
            <div class="card shadow-sm h-100 rounded-0">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-start gap-4 ps-5">
                        <button class="btn btn-outline-primary btn-lg">Sign Up</button>
                        <button class="btn btn-primary btn-lg">Log In</button>
                    </div>
                    <form method="POST" action="/login" style="margin-top: 10rem;">
                        <div class="form-group mb-4 ps-5">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control form-control-lg" id="email" name="email"
                                placeholder="Enter email" required>
                        </div>
                        <div class="form-group mb-4 ps-5">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control form-control-lg" id="password" name="password"
                                placeholder="Enter password" required>
                        </div>
                        <div class="ps-5">
                            <button type="submit" class="btn btn-primary btn-lg w-100 mb-4 py-3">Login</button>
                        </div>
                        <div class="ps-5 text-center">
                            <p class="text-muted small">
                                By clicking Log in, you accept Quizlet's
                                <a href="/terms" class="text-decoration-none">Terms of Service</a> and
                                <a href="/privacy" class="text-decoration-none">Privacy Policy</a>
                            </p>
                        </div>
                    </form>
                    <div class="text-center ps-5">
                        <a href="/register" class="btn btn-outline-secondary btn-lg w-100 mb-4 ">New to Kuizlet? Create
                            an account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>